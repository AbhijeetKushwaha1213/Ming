# ==============================================================================
# Ming — Multimodal AI-Powered Adaptive Learning Platform
# Environment Configuration Template
# Copy this file to .env and configure for your target environment:
#   cp .env.example .env
# Never commit the .env file containing actual secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Server Runtime
# ------------------------------------------------------------------------------
APP_ENV="development" # 'development' | 'staging' | 'production'
NODE_ENV="development"
API_PORT="3001"
API_HOST="127.0.0.1"
CORS_ORIGIN="http://localhost:8080"

# ------------------------------------------------------------------------------
# 2. Database Configuration
# ------------------------------------------------------------------------------
# Local Development (SQLite):
DATABASE_URL="file:./prisma/dev.db"

# Production / Staging (PostgreSQL / Supabase):
# DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?sslmode=require&pgbouncer=true"
# DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?sslmode=require"

# Optional LibSQL / Turso Cloud Database:
# TURSO_DATABASE_URL="libsql://your-database.turso.io"
# TURSO_AUTH_TOKEN="your_turso_auth_token"

# ------------------------------------------------------------------------------
# 3. Vector Store Configuration
# ------------------------------------------------------------------------------
# Local Development: 'chroma'
# Production / Staging: 'pgvector'
VECTOR_STORE="chroma"
# PGVECTOR_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?sslmode=require"

# ------------------------------------------------------------------------------
# 4. Supabase Authentication & Storage
# ------------------------------------------------------------------------------
# Public / Client-Side Keys (Safe for frontend bundle):
VITE_SUPABASE_URL="https://your_project_ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your_supabase_publishable_or_anon_key"

# Server-Side Keys (Confidential — Never expose to client):
SUPABASE_URL="https://your_project_ref.supabase.co"
ANON_KEY="your_supabase_anon_key"
# SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_secret_key"
# JWT_KEY="your_supabase_jwt_secret_key"

# ------------------------------------------------------------------------------
# 5. Google Gemini AI Gateway
# ------------------------------------------------------------------------------
# Get your API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your_gemini_api_key_here"
VITE_GEMINI_API_KEY="your_gemini_api_key_here"

# ------------------------------------------------------------------------------
# 6. Security Invariants
# ------------------------------------------------------------------------------
# ALLOW_DEV_AUTH_BYPASS must NEVER be 'true' in staging or production.
# The server will fail to start (fail-closed) if set to true in production.
ALLOW_DEV_AUTH_BYPASS="false"
