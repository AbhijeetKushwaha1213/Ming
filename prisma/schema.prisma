// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Resource {
  id          String   @id @default(cuid())
  userId      String
  title     String
  description String?
  type        String
  noteContent String?
  linkUrl     String?
  fileUrl     String?
  storagePath String?
  folder      String?
  tagsJson    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([userId, type])
  @@map("resources")
}

model AssessmentQuestion {
  id             String   @id @default(cuid())
  userId         String
  fingerprint    String
  type           String
  topic          String
  subtopic       String?
  difficulty     String
  sourceId       String?
  chunkId        String?
  pageNumber     Int?
  slideNumber    Int?
  timestampStart Float?
  timestampEnd   Float?
  question       String
  optionsJson    String?
  correctAnswer  String
  explanation    String
  createdAt      DateTime @default(now())

  @@index([userId, topic])
  @@index([userId, fingerprint])
  @@map("assessment_questions")
}

model AssessmentAttempt {
  id             String   @id @default(cuid())
  userId         String
  title          String
  topic          String
  subtopic       String?
  difficulty     String
  score          Float
  totalQuestions Int
  correctCount   Int
  percentage     Float
  questionsJson  String
  answersJson    String
  diagnosticJson String
  completedAt    DateTime @default(now())

  @@index([userId, completedAt])
  @@index([userId, topic])
  @@map("assessment_attempts")
}

model LearnerMastery {
  id                 String    @id @default(cuid())
  userId             String
  courseId           String?
  topic              String
  subtopic           String?
  masteryProbability Float     @default(0.0)
  attempts           Int       @default(0)
  correctCount       Int       @default(0)
  incorrectCount     Int       @default(0)
  confidence         Float     @default(0.0)
  status             String    @default("unassessed")
  lastAssessedAt     DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([userId, topic])
  @@index([userId, status])
  @@map("learner_mastery")
}

model LearnerEvent {
  id               String   @id @default(cuid())
  userId           String
  topic            String
  subtopic         String?
  eventType        String
  sourceId         String?
  priorMastery     Float
  posteriorMastery Float
  isCorrect        Boolean?
  difficulty       String?
  parametersJson   String?
  evidenceDetails  String?
  timestamp        DateTime @default(now())

  @@index([userId, timestamp])
  @@index([userId, topic])
  @@map("learner_events")
}

