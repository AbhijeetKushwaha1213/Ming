// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Resource {
  id          String   @id @default(cuid())
  userId      String
  title     String
  description String?
  type        String
  noteContent String?
  linkUrl     String?
  fileUrl     String?
  storagePath String?
  folder      String?
  tagsJson    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([userId, type])
  @@map("resources")
}

model AssessmentQuestion {
  id             String   @id @default(cuid())
  userId         String
  fingerprint    String
  type           String
  topic          String
  subtopic       String?
  difficulty     String
  sourceId       String?
  chunkId        String?
  pageNumber     Int?
  slideNumber    Int?
  timestampStart Float?
  timestampEnd   Float?
  question       String
  optionsJson    String?
  correctAnswer  String
  explanation    String
  createdAt      DateTime @default(now())

  @@index([userId, topic])
  @@index([userId, fingerprint])
  @@map("assessment_questions")
}

model AssessmentAttempt {
  id             String   @id @default(cuid())
  userId         String
  title          String
  topic          String
  subtopic       String?
  difficulty     String
  score          Float
  totalQuestions Int
  correctCount   Int
  percentage     Float
  questionsJson  String
  answersJson    String
  diagnosticJson String
  completedAt    DateTime @default(now())

  @@index([userId, completedAt])
  @@index([userId, topic])
  @@map("assessment_attempts")
}

model LearnerMastery {
  id                 String    @id @default(cuid())
  userId             String
  courseId           String?
  topic              String
  subtopic           String?
  masteryProbability Float     @default(0.0)
  attempts           Int       @default(0)
  correctCount       Int       @default(0)
  incorrectCount     Int       @default(0)
  confidence         Float     @default(0.0)
  status             String    @default("unassessed")
  lastAssessedAt     DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([userId, topic])
  @@index([userId, status])
  @@map("learner_mastery")
}

model LearnerEvent {
  id               String   @id @default(cuid())
  userId           String
  topic            String
  subtopic         String?
  eventType        String
  sourceId         String?
  priorMastery     Float
  posteriorMastery Float
  isCorrect        Boolean?
  difficulty       String?
  parametersJson   String?
  evidenceDetails  String?
  timestamp        DateTime @default(now())

  @@index([userId, timestamp])
  @@index([userId, topic])
  @@map("learner_events")
}

model StudyPlan {
  id            String   @id @default(cuid())
  userId        String
  planDate      String   // 'YYYY-MM-DD'
  title         String
  targetMinutes Int      @default(60)
  status        String   @default("active") // 'active', 'completed', 'archived'
  summary       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, planDate])
  @@index([userId, status])
  @@map("study_plans")
}

model StudyPlanItem {
  id               String    @id @default(cuid())
  planId           String
  userId           String
  priority         Int
  priorityScore    Float
  topic            String
  subtopic         String?
  activityType     String
  title            String
  description      String
  estimatedMinutes Int
  reason           String
  expectedOutcome  String
  sourceId         String?
  chunkId          String?
  sourceTitle      String?
  status           String    @default("pending") // 'pending', 'in_progress', 'completed', 'skipped', 'blocked'
  conceptId        String?
  category         String?
  questionId       String?
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId, planId])
  @@index([userId, status])
  @@map("study_plan_items")
}

model AssessmentEvaluation {
  id               String   @id @default(cuid())
  attemptId        String
  userId           String
  questionId       String
  questionText     String
  questionType     String
  userAnswer       String
  correctAnswer    String
  classification   String   // 'correct', 'partially_correct', 'incorrect'
  credit           Float
  feedback         String
  explanation      String?
  sourceId         String?
  chunkId          String?
  sourceCoordinate String?
  createdAt        DateTime @default(now())

  @@index([attemptId])
  @@index([userId, createdAt])
  @@map("assessment_evaluations")
}

model AssessmentMisconception {
  id               String   @id @default(cuid())
  attemptId        String
  evaluationId     String?
  userId           String
  topic            String
  subtopic         String?
  concept          String
  misconceptionType String  // 'CONCEPT_CONFUSION', 'MECHANISM_INVERSION', etc.
  description      String
  studentAnswer    String
  expectedAnswer   String
  sourceId         String?
  chunkId          String?
  sourceCoordinate String?
  severity         String   @default("medium")
  createdAt        DateTime @default(now())

  @@index([userId, topic])
  @@index([attemptId])
  @@index([concept])
  @@map("assessment_misconceptions")
}

model Video {
  id               String   @id @default(cuid())
  userId           String
  title            String
  sourceType       String   // 'youtube' | 'upload'
  youtubeUrl       String?
  youtubeVideoId   String?
  storagePath      String?
  fileUrl          String?
  status           String   @default("pending") // 'pending' | 'processing' | 'ready' | 'failed'
  durationSeconds  Float    @default(0)
  thumbnailUrl     String?
  transcriptStatus String   @default("pending") // 'pending' | 'processing' | 'ready' | 'failed'
  transcriptJson   String?
  errorMessage     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([userId, sourceType])
  @@map("videos")
}

model LearningDAG {
  id                   String   @id @default(cuid())
  userId               String
  title                String
  courseId             String?
  topic                String
  subtopic             String?
  sourceMaterialIds    String?
  graphDepth           String   @default("Standard")
  learningGoal         String   @default("Concept Mastery")
  nodesJson            String
  edgesJson            String?
  masteryStatesJson    String?
  sourceReferencesJson String?
  progressStatus       String   @default("active")
  progressPercent      Float    @default(0.0)
  currentConceptId     String?
  nextConceptId        String?
  totalConcepts        Int      @default(0)
  masteredConcepts     Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  lastOpenedAt         DateTime @default(now())

  @@index([userId, updatedAt])
  @@index([userId, topic])
  @@map("learning_dags")
}

model AnalyticsEvent {
  id                  String   @id @default(cuid())
  userId              String
  eventType           String
  eventPropertiesJson String?
  timestamp           DateTime @default(now())

  @@index([userId, timestamp])
  @@index([userId, eventType])
  @@map("analytics_events")
}


